{
  "name": "mti-city-demos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MTI Solutions Explorer - ciudad 3D interactiva para presentar las soluciones de Mingo Things",
  "scripts": {
    "dev": "concurrently -n API,WEB -c yellow,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server/index.js",
    "preview": "vite preview",
    "city:fetch": "node scripts/fetch-city.mjs",
    "city:ortho": "node scripts/fetch-ortho.mjs",
    "city:photos": "node scripts/fetch-photos.mjs",
    "city:ortho:detail": "node scripts/fetch-ortho.mjs -- --detail"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "3d-tiles-renderer": "^0.5.2",
    "compression": "^1.8.1",
    "express": "^5.2.1",
    "maplibre-gl": "^6.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.170.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^10.0.5",
    "puppeteer": "^25.10.0",
    "vite": "^5.4.10"
  }
}
